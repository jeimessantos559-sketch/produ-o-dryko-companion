# Navegador: valores públicos do projeto Supabase de destino.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Servidor: configurar na Vercel; a chave privada nunca deve ter prefixo VITE_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=

# Envio de relatórios pelo Apps Script, quando configurado.
APPS_SCRIPT_WEB_APP_URL=
APPS_SCRIPT_API_TOKEN=

# Integração de e-mail do Lovable, quando utilizada.
LOVABLE_API_KEY=
GOOGLE_MAIL_API_KEY=
GOOGLE_MAIL_API_KEY_1=

# Rotinas de servidor, quando configuradas.
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=

# Backup: segredos exclusivos do ambiente que executa a cópia.
SUPABASE_DATABASE_URL=
BACKUP_ENCRYPTION_KEY=
