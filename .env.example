# Supabase acessado pelo navegador (chave publica/publishable)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Identificador opcional usado por algumas integracoes/plataformas.
VITE_SUPABASE_PROJECT_ID=

# Supabase acessado durante SSR e funcoes do servidor
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

# URL publica do aplicativo, sem barra final. Usada em links de recuperacao.
APP_URL=

# Integracao de e-mail do Lovable (quando a hospedagem oferece o conector)
LOVABLE_API_KEY=
GOOGLE_MAIL_API_KEY=
# Algumas contas fornecem a conexao com o sufixo _1.
GOOGLE_MAIL_API_KEY_1=

# Alternativa portavel para o envio de relatorios por Google Apps Script
APPS_SCRIPT_WEB_APP_URL=
APPS_SCRIPT_API_TOKEN=

# Protege rotinas agendadas. Durante rotacao, aceite temporariamente a anterior.
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=

# Usada apenas por ferramentas de migracao quando configuradas pela plataforma.
LOVABLE_DB_MIGRATION_URL=
